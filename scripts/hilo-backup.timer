[Unit]
Description=Hilo daily backup timer
Documentation=https://github.com/Ingenarte/hilo-community

[Timer]
# Daily at 03:15. RandomizedDelaySec spreads it across nodes if you ever
# clone the setup (multiple boxes won't all backup at the same second).
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=10min
Persistent=true
Unit=hilo-backup.service

[Install]
WantedBy=timers.target
