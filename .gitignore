node_modules
.DS_Store
.svelte-kit
build
package-lock.json
yarn.lock

# Never commit real secrets.
.env
.env.local
.env.*.local

# Runtime data — never commit
data/
# The leading slash scopes this to the repo root so it does not
# accidentally shadow src/routes/api/uploads/ route files.
/uploads/
*.db
*.db-journal
*.db-wal
*.db-shm

# Editor
.vscode
.idea
*.swp
*.swo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Playwright artefacts (recorded videos, traces, snapshots) — re-generated by `pnpm screenshots` / `pnpm demo`
playwright/
test-results/

# Large generated test fixtures (generate locally with ffmpeg — see scripts/screenshot-chunked-upload.mjs)
tests/fixtures/*.mp4
tests/fixtures/*.mkv
tests/fixtures/*.webm

# Playwright auth state (session cookies written by global-setup.ts — never commit)
tests/e2e/.auth/

# Audit / sprint artefacts — generated locally, not committed
audit-screenshots/
tests/e2e/a11y-report.json
/tmp/hilo-android-test/

# Internal audit / sprint artefacts
SPRINT*.md
VIEWPORT_AUDIT.md
VISION_AUDIT.md
iOS_Android.md
