{
	"id": "/?source=pwa",
	"name": "Hilo",
	"short_name": "Hilo",
	"description": "Lightweight self-hosted ticket + chat. Open source, SQLite-only.",
	"start_url": "/tickets?source=pwa",
	"scope": "/",
	"display": "standalone",
	"display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
	"orientation": "any",
	"theme_color": "#0b0f1a",
	"background_color": "#0b0f1a",
	"lang": "en",
	"dir": "ltr",
	"categories": ["productivity", "business"],
	"prefer_related_applications": false,
	"launch_handler": {
		"client_mode": "focus-existing"
	},
	"icons": [
		{
			"src": "/favicon.svg",
			"type": "image/svg+xml",
			"sizes": "any",
			"purpose": "any"
		},
		{
			"src": "/logo-192.png",
			"type": "image/png",
			"sizes": "192x192",
			"purpose": "any"
		},
		{
			"src": "/logo-192-maskable.png",
			"type": "image/png",
			"sizes": "192x192",
			"purpose": "maskable"
		},
		{
			"src": "/logo-256.png",
			"type": "image/png",
			"sizes": "256x256",
			"purpose": "any"
		},
		{
			"src": "/logo-512.png",
			"type": "image/png",
			"sizes": "512x512",
			"purpose": "any"
		},
		{
			"src": "/logo-512-maskable.png",
			"type": "image/png",
			"sizes": "512x512",
			"purpose": "maskable"
		}
	],
	"screenshots": [
		{
			"src": "/screenshot-inbox-wide.png",
			"type": "image/png",
			"sizes": "1280x800",
			"form_factor": "wide",
			"label": "Hilo inbox"
		},
		{
			"src": "/screenshot-ticket-wide.png",
			"type": "image/png",
			"sizes": "1280x800",
			"form_factor": "wide",
			"label": "A ticket conversation"
		},
		{
			"src": "/screenshot-inbox-narrow.png",
			"type": "image/png",
			"sizes": "750x1334",
			"form_factor": "narrow",
			"label": "Hilo inbox on phone"
		}
	],
	"shortcuts": [
		{
			"name": "New ticket",
			"short_name": "New",
			"description": "Open the new-ticket form",
			"url": "/tickets/new",
			"icons": [
				{ "src": "/logo-192.png", "sizes": "192x192", "type": "image/png" }
			]
		},
		{
			"name": "Inbox",
			"short_name": "Inbox",
			"description": "Go to the inbox",
			"url": "/tickets",
			"icons": [
				{ "src": "/logo-192.png", "sizes": "192x192", "type": "image/png" }
			]
		}
	],
	"related_applications": []
}
