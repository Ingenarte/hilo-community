app=""; for d in "$HOME/Applications" "/Applications"; do for s in "Chrome Apps.localized" "Edge Apps.localized" "Chrome Canary Apps.localized" "Chrome Beta Apps.localized" ""; do p="$d/$s/Hilo.app"; [ -d "$p" ] && { app="$p"; break 2; }; done; done; [ -z "$app" ] && app="$(find "$HOME/Applications" /Applications -maxdepth 4 -iname 'Hilo.app' -type d 2>/dev/null | head -n1)"; if [ -z "$app" ]; then echo "Hilo.app not found. Install the Hilo PWA first: open https://__HILO_BASE_URL__ in Chrome or Edge, then use the address-bar Install icon (or Menu > Cast, Save & Share > Install). Re-run this command afterward."; else /usr/bin/osascript -e "tell application \"System Events\" to if not (exists login item \"Hilo\") then make login item at end with properties {path:\"$app\", hidden:true, name:\"Hilo\"}" && echo "Login item ready (hidden) -> $app"; fi