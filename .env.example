# ─── Hilo configuration ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
# Production note: prefer keeping the real env file OUTSIDE the repo checkout
# (e.g. /etc/hilo/hilo.env, chmod 0600, chown root:root) and point your
# compose override at it via `env_file:` so secrets never end up in
# `docker inspect` output or git.

# ─── Public ─────────────────────────────────────────────────────────────────
# Base URL where Hilo is reachable. Used to build magic links inside emails,
# the CSRF trusted-origins list (build time), and the install-guide copy.
# In production this must be the public URL (https://support.example.com).
PUBLIC_BASE_URL=http://localhost:5180

# Short brand label shown across the UI. Keep it short (≤ 12 chars).
PUBLIC_BRAND=Hilo
# Shown on the login "What is Hilo?" panel as the invite contact. Optional.
PUBLIC_SUPPORT_EMAIL=admin@example.com
# Optional: organization name shown on the public landing page.
PUBLIC_INSTANCE_OWNER=

# ─── Admin ──────────────────────────────────────────────────────────────────
# The bootstrap admin account (auto-provisioned on first start).
ADMIN_EMAIL=mail@example.com

# ─── Auth ───────────────────────────────────────────────────────────────────
# Bootstrap fixed password. Users get individual passwords once created.
AUTH_FIXED_PASSWORD=change-me-please

# Optional separate password for the admin account. If unset, admin uses
# AUTH_FIXED_PASSWORD.
AUTH_ADMIN_FIXED_PASSWORD=

# Format for the date-derived "dynamic code". Use any combination of:
#   dd    day of month (01-31)
#   mm    month (01-12)
#   yy    last two digits of the year (00-99)
#   yyyy  full year (0000-9999)
# Common variants: ddmmyy (default), ddmmyyyy, mmddyy, yyyymmdd, yymmdd.
# Set to `none` to disable the dynamic code entirely (only the fixed pw matters).
AUTH_DYNAMIC_FORMAT=none

# Days of tolerance around the server-local date to absorb timezone drift.
# 0 = exact match required; 1 = yesterday / today / tomorrow accepted.
AUTH_DYNAMIC_WINDOW_DAYS=1

# 32+ character random string. Used to sign session cookies and magic-link tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string-please-change-this

# ─── SMTP (Nodemailer) ──────────────────────────────────────────────────────
# Gmail with an App Password is the simplest path. Create one at:
# https://myaccount.google.com/apppasswords (requires 2FA enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mail@example.com
SMTP_PASS=your-smtp-app-password-here
SMTP_FROM="Hilo <mail@example.com>"

# ─── Web Push (VAPID) ───────────────────────────────────────────────────────
# Optional. Generate a keypair with:
#   npx web-push generate-vapid-keys
# Leave empty to disable browser push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Uploads ────────────────────────────────────────────────────────────────
# Max TOTAL size in MB for a single attachment (chunked uploads supported).
MAX_UPLOAD_MB=500
# Directory where attachments are stored (relative or absolute).
UPLOAD_DIR=./uploads
# Retention for uploaded files in days. 0 or empty = keep forever.
UPLOAD_RETAIN_DAYS=180

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite file path.
DATABASE_PATH=./data/hilo.db

# ─── Transcription (faster-whisper sidecar) ─────────────────────────────────
# The docker-compose stack starts the sidecar automatically; these defaults
# match it. For bare-metal dev without the sidecar, transcription simply
# reports unavailable.
WHISPER_URL=http://localhost:8000
WHISPER_MODEL=Systran/faster-whisper-base
WHISPER_MAX_CONCURRENT=1

# ─── Cloudflare Tunnel (optional, production overlay) ───────────────────────
# Only needed when using docker-compose.production.yml's cloudflared sidecar.
CLOUDFLARED_TOKEN=

# New passwords are screened against known breaches with the Have I Been Pwned
# range API (k-anonymity: only a 5-character hash prefix leaves the server).
# The check fails open if the service is unreachable. Set to 0 to disable.
# PWNED_PASSWORDS_CHECK=1

# Passkeys (WebAuthn) let people sign in with a fingerprint, face or screen
# lock. They need HTTPS and use the host of PUBLIC_BASE_URL as the relying-party
# id. A passkey sign-in with user verification skips the daily access code
# (AUTH_DYNAMIC_FORMAT). Set to 0 to turn the feature off.
# PASSKEYS_ENABLED=1
